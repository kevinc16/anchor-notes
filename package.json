{
  "name": "anchor-notes",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "compile": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css}\"",
    "lint": "npm run lint:ts && npm run lint:css",
    "lint:fix": "npm run format && npm run lint:ts -- --fix && npm run lint:css -- --fix",
    "lint:ts": "eslint . --max-warnings=0",
    "lint:css": "stylelint \"styles/**/*.css\" \"entrypoints/**/*.css\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "build:firefox": "wxt build --browser firefox",
    "validate:firefox": "node scripts/validate-firefox-build.mjs",
    "zip:firefox": "wxt zip --browser firefox",
    "zip": "wxt zip",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@checkly/playwright-reporter": "^1.15.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-tailwindcss": "^1.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
